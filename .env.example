# Optional: richer natural-language interpretation. Set locally; never commit keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Synthetic classroom is enabled in development by default.
# Set true for a LOCAL production-mode demo. Never enable for real students.
ALLOW_DEMO=true

# Set true when served over HTTPS. Keep false for http://127.0.0.1.
COOKIE_SECURE=false

# Optional SQLite location. Defaults to .data/favourloop.sqlite.
# FAVOURLOOP_DB=/absolute/path/favourloop.sqlite

# Hosted deployments use Postgres; leave unset for local SQLite.
# DATABASE_URL=postgresql://...

# Optional canonical origin when deployed behind an HTTPS proxy.
# FAVOURLOOP_ORIGIN=https://your-school.example

# Set false to keep classmate matching local while retaining AI interpretation.
OPENAI_MATCHING_ENABLED=true
